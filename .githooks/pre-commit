#!/usr/bin/env bash
# Crochet de pré-commit — moment d'exécution choisi par le projet (§5).
#
# Rapide par construction : ce qui dure se joue au pré-push et au passage
# complet. Un budget dépassé se signale, il ne s'attend pas.
#
# Il ne prouve rien : un crochet se contourne, et il tourne sur le poste de qui
# pourrait vouloir le contourner. Ce qui tient la continuité, c'est le rejeu au
# niveau supérieur (§4.4).

set -euo pipefail
debut=$(date +%s)

echo "· scripts"
if command -v shellcheck > /dev/null 2>&1; then
  shellcheck .github/scripts/*.sh .githooks/pre-commit
else
  echo "  shellcheck absent — sauté ici, exigé dans le passage complet"
fi

echo "· empreinte"
bash .github/scripts/empreinte.sh . .garde/empreinte-exclusions > /dev/null

echo "· documents"
bash tests/documents.sh

echo "· workflows"
bash tests/workflows.sh

# Le harnais du plancher ne se joue que si la règle qu'il juge existe : tant
# qu'elle est due au codage, il rougirait à chaque commit et cesserait d'être lu
# (§4.2). Son rouge est alors porté par l'issue, pas par le crochet.
if [ -f .github/scripts/verdict.sh ]; then
  echo "· plancher"
  # Le verdict vient au crochet AVEC son message d'échec (§5) : sans lui, celui
  # qui code ne voit qu'un compte de rouges et doit rouvrir le harnais pour
  # savoir lequel — ce qu'on lui demande précisément de ne pas faire. Le détail
  # ne sort que s'il rougit, pour ne pas noyer le vert sous la trace.
  if ! detail=$(bash tests/plancher.sh 2>&1); then
    printf '%s\n' "$detail" >&2
    exit 1
  fi
fi

if [ -f Cargo.toml ]; then
  echo "· forme"
  if cargo fmt --version > /dev/null 2>&1; then
    cargo fmt --all -- --check
  else
    echo "  rustfmt absent — saute ici, exige dans le passage complet"
  fi
  # `tests/temoins.sh` n'est PAS joué ici : il recompile à chaque mutation, et le
  # budget du crochet est de dix secondes. Sa place est le passage complet.
  # clippy au crochet : #14 a ete decouvert par le passage complet alors qu'il
  # tombait aussi en local. Ce qui se voit en une seconde ici n'a pas a couter
  # un aller-retour de CI.
  #
  # Absent, il est saute comme shellcheck, et pour la meme raison : le crochet
  # est un passage ordinaire, ou un outil manquant ne peut pas conclure et le
  # dit ; le passage complet est strict, et l'y installe. §4.2 separe « rouge »
  # de « n'a pas pu tourner » exactement pour ca, et deux outils absents ne
  # peuvent pas avoir deux comportements sans que rien ne le dise.
  echo "· clippy"
  if cargo clippy --version > /dev/null 2>&1; then
    cargo clippy --all-targets --all-features -- -D warnings
  else
    echo "  clippy absent — saute ici, exige dans le passage complet"
  fi

  echo "· harnais"
  # `--lib` ne jouerait rien : les harnais vivent dans `tests/`, hors de
  # l'empreinte, pour que les corriger n'annule pas une validation (§4.4).
  cargo test --quiet
fi

duree=$(( $(date +%s) - debut ))
echo "· ${duree}s"
if [ "$duree" -gt 10 ]; then
  echo "  budget dépassé : trier, pas attendre (annexe B)" >&2
fi
